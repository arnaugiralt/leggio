# Cloudflare static assets: copied into site/ by build.mjs.
# No Cache-Control under /*: rules that match the same path join their values, so a no-cache here would
# also land on /assets/* and cancel the immutable caching. Cloudflare's default
# (public, max-age=0, must-revalidate) already makes the page and the service worker revalidate.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' blob: data: https:; connect-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Previews (canary, and <branch>.leggio.compostela.dev) stay out of search results. A placeholder never matches a dot,
# so this misses leggio.compostela.dev itself. Not robots.txt: it is one file for every host, and a crawler
# that is blocked from a page never sees its noindex.
https://:preview.leggio.compostela.dev/*
  X-Robots-Tag: noindex
