// Cloudflare Worker with static assets only: no script, so every request is a free asset request.
// A custom domain, not a route: Cloudflare creates the DNS record and certificate for it, while a route
// only matches traffic on a hostname that already resolves. Don't move it once people install the app,
// because an install is tied to its exact origin.
{
  "name": "leggio",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./site" },
  // previews_enabled serves each Preview at <name>.leggio.compostela.dev: master's is canary (the Preview command in
  // Workers Builds names it). Production deploys apply it; a Preview build alone doesn't.
  "routes": [{ "pattern": "leggio.compostela.dev", "custom_domain": true, "previews_enabled": true }],
  // Pushes to master and other branches build a Preview with `wrangler preview`, which needs this block, even empty.
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
